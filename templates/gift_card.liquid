{% layout none %}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ shop.name }} gift card</title>
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body style="background:#0b0c0e; color:#f4f5f7; font-family:system-ui,sans-serif">
    <main style="min-height:100vh; display:grid; place-items:center; padding:2rem 1rem; text-align:center">
      <div style="display:grid; gap:1rem; justify-items:center">
        <h1>{{ shop.name }}</h1>
        <p>Gift card</p>
        <p style="font-size:3rem; font-weight:700">{{ gift_card.balance | money }}</p>
        {{ gift_card.qr_identifier }}
        <p style="font-family:monospace; letter-spacing:.2em; font-size:1.25rem">
          {{ gift_card.code | format_code }}
        </p>
        <a href="{{ shop.url }}" style="color:#d7ff3e">{{ shop.url }}</a>
      </div>
    </main>
  </body>
</html>
