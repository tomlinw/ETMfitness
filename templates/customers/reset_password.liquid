<div class="page-width page-width--narrow section" style="max-width:460px">
  <h1 style="margin-bottom:1.5rem">Reset password</h1>

  {%- form 'reset_customer_password', class: 'grid', style: 'gap:1rem' -%}
    {%- if form.errors -%}
      <p class="form-status form-status--error">{{ form.errors | default_errors }}</p>
    {%- endif -%}

    <div class="field">
      <label class="field__label" for="ResetPassword">New password</label>
      <input class="input" id="ResetPassword" type="password" name="customer[password]" autocomplete="new-password" required>
    </div>
    <div class="field">
      <label class="field__label" for="ResetPasswordConfirm">Confirm password</label>
      <input class="input" id="ResetPasswordConfirm" type="password" name="customer[password_confirmation]" autocomplete="new-password" required>
    </div>

    <button class="button" type="submit">Reset password</button>
  {%- endform -%}
</div>
