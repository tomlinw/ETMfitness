<div class="page-width section">
  <div style="display:flex; flex-wrap:wrap; align-items:baseline; justify-content:space-between; gap:1rem; margin-bottom:2rem">
    <h1>My account</h1>
    <a class="link-arrow" href="{{ routes.account_logout_url }}">Log out</a>
  </div>

  <div class="cart-page">
    <div>
      <h2 class="h3" style="margin-bottom:1rem">Order history</h2>

      {%- paginate customer.orders by 20 -%}
        {%- if customer.orders.size == 0 -%}
          <p class="text-muted">You haven't placed any orders yet.</p>
        {%- else -%}
          <ul role="list">
            {%- for order in customer.orders -%}
              <li class="cart-item" style="grid-template-columns:1fr">
                <div class="cart-item__details">
                  <a class="cart-item__title" href="{{ order.customer_url }}">Order {{ order.name }}</a>
                  <span class="cart-item__variant">
                    {{ order.created_at | date: '%b %d, %Y' }} · {{ order.financial_status_label }} ·
                    {{ order.fulfillment_status_label }}
                  </span>
                  <strong>{{ order.total_price | money }}</strong>
                </div>
              </li>
            {%- endfor -%}
          </ul>
          {% render 'pagination', paginate: paginate %}
        {%- endif -%}
      {%- endpaginate -%}
    </div>

    <aside class="cart-summary">
      <h2 class="h3">Default address</h2>
      {%- if customer.default_address -%}
        <div class="text-muted">{{ customer.default_address | format_address }}</div>
      {%- else -%}
        <p class="text-muted">No address saved yet.</p>
      {%- endif -%}
      <a class="button button--secondary button--full" href="{{ routes.account_addresses_url }}">Manage addresses</a>
    </aside>
  </div>
</div>
