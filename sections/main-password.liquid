<div class="page-width page-width--narrow text-center" style="display:grid; gap:1.5rem; justify-items:center">
  {%- if settings.logo != blank -%}
    <img
      src="{{ settings.logo | image_url: width: 500 }}"
      alt="{{ shop.name | escape }}"
      width="{{ settings.logo.width }}"
      height="{{ settings.logo.height }}"
      style="width:{{ settings.logo_width }}px; height:auto"
    >
  {%- else -%}
    <h1 class="h2">{{ shop.name }}</h1>
  {%- endif -%}

  <span class="eyebrow">{{ 'password.opening_soon' | t }}</span>
  <h2>{{ section.settings.heading | default: shop.password_message | escape }}</h2>
  <p class="text-muted">{{ 'password.message' | t }}</p>

  {%- form 'customer', class: 'newsletter__form', style: 'justify-content:center' -%}
    <input type="hidden" name="contact[tags]" value="prelaunch">
    <label class="visually-hidden" for="PasswordEmail">{{ 'general.newsletter_form.email_placeholder' | t }}</label>
    <input
      class="input"
      id="PasswordEmail"
      type="email"
      name="contact[email]"
      placeholder="{{ 'general.newsletter_form.email_placeholder' | t }}"
      required
    >
    <button class="button" type="submit">{{ 'general.newsletter_form.submit' | t }}</button>
    {%- if form.posted_successfully? -%}
      <p class="form-status form-status--success" style="width:100%">{{ 'general.newsletter_form.success' | t }}</p>
    {%- endif -%}
  {%- endform -%}

  <details style="margin-top:2rem">
    <summary class="accordion__summary">{{ 'password.login_prompt' | t }}</summary>
    {%- form 'storefront_password', class: 'newsletter__form', style: 'justify-content:center; margin-top:1rem' -%}
      <label class="visually-hidden" for="StorefrontPassword">{{ 'password.password_label' | t }}</label>
      <input class="input" id="StorefrontPassword" type="password" name="password" autocomplete="current-password">
      <button class="button" type="submit">{{ 'password.login' | t }}</button>
      {%- if form.errors -%}
        <p class="form-status form-status--error" style="width:100%">{{ form.errors.messages.form }}</p>
      {%- endif -%}
    {%- endform -%}
  </details>
</div>

{% schema %}
{
  "name": "Password page",
  "settings": [{ "type": "text", "id": "heading", "label": "Heading", "default": "Something heavy is coming" }]
}
{% endschema %}
