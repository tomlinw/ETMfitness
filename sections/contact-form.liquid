<div class="page-width page-width--narrow section">
  <h1>{{ page.title | default: section.settings.heading | escape }}</h1>
  {%- if page.content != blank -%}
    <div class="rte text-muted" style="margin-top:1rem">{{ page.content }}</div>
  {%- endif -%}

  {%- form 'contact', class: 'grid', style: 'margin-top:2rem; gap:1rem' -%}
    {%- if form.posted_successfully? -%}
      <p class="form-status form-status--success">{{ 'contact.form.post_success' | t }}</p>
    {%- elsif form.errors -%}
      <p class="form-status form-status--error">{{ form.errors | default_errors }}</p>
    {%- endif -%}

    <div class="field">
      <label class="field__label" for="ContactName">{{ 'contact.form.name' | t }}</label>
      <input class="input" id="ContactName" type="text" name="contact[name]" value="{{ form.name }}" autocomplete="name">
    </div>

    <div class="field">
      <label class="field__label" for="ContactEmail">{{ 'contact.form.email' | t }}</label>
      <input
        class="input"
        id="ContactEmail"
        type="email"
        name="contact[email]"
        value="{{ form.email }}"
        autocomplete="email"
        required
      >
    </div>

    <div class="field">
      <label class="field__label" for="ContactPhone">{{ 'contact.form.phone' | t }}</label>
      <input class="input" id="ContactPhone" type="tel" name="contact[phone]" value="{{ form.phone }}" autocomplete="tel">
    </div>

    <div class="field">
      <label class="field__label" for="ContactMessage">{{ 'contact.form.message' | t }}</label>
      <textarea class="input" id="ContactMessage" name="contact[body]" required>{{ form.body }}</textarea>
    </div>

    <button class="button" type="submit" style="justify-self:start">{{ 'contact.form.send' | t }}</button>
  {%- endform -%}
</div>

{% schema %}
{
  "name": "Contact form",
  "settings": [{ "type": "text", "id": "heading", "label": "Heading", "default": "Get in touch" }]
}
{% endschema %}
