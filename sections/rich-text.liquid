<section class="section">
  <div class="page-width page-width--narrow text-center reveal" style="display:grid; gap:1rem; justify-items:center">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'eyebrow' -%}
          <span class="eyebrow" {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</span>
        {%- when 'heading' -%}
          <h2 {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</h2>
        {%- when 'text' -%}
          <div class="rte text-muted" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
        {%- when 'button' -%}
          <a class="button" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>
            {{ block.settings.label | escape }}
          </a>
      {%- endcase -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Rich text",
  "blocks": [
    {
      "type": "eyebrow",
      "name": "Eyebrow",
      "limit": 1,
      "settings": [{ "type": "text", "id": "text", "label": "Text", "default": "The standard" }]
    },
    {
      "type": "heading",
      "name": "Heading",
      "limit": 1,
      "settings": [{ "type": "text", "id": "text", "label": "Text", "default": "No filler. No showroom markup." }]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>We stock a short list on purpose. Every item earns its place by surviving a season of real training before it goes live.</p>"
        }
      ]
    },
    {
      "type": "button",
      "name": "Button",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Read our standards" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Rich text",
      "blocks": [{ "type": "eyebrow" }, { "type": "heading" }, { "type": "text" }]
    }
  ]
}
{% endschema %}
