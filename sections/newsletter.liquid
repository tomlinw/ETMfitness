<section class="section">
  <div class="page-width page-width--narrow">
    <div class="newsletter reveal">
      {%- if section.settings.eyebrow != blank -%}
        <span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>
      {%- endif -%}
      <h2>{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}
        <p class="text-muted">{{ section.settings.text | escape }}</p>
      {%- endif -%}

      {%- form 'customer', class: 'newsletter__form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <label class="visually-hidden" for="NewsletterEmail">
          {{ 'general.newsletter_form.email_placeholder' | t }}
        </label>
        <input
          class="input"
          id="NewsletterEmail"
          type="email"
          name="contact[email]"
          placeholder="{{ 'general.newsletter_form.email_placeholder' | t }}"
          autocomplete="email"
          required
        >
        <button class="button" type="submit">{{ 'general.newsletter_form.submit' | t }}</button>

        {%- if form.posted_successfully? -%}
          <p class="form-status form-status--success" style="width:100%">
            {{ 'general.newsletter_form.success' | t }}
          </p>
        {%- elsif form.errors -%}
          <p class="form-status form-status--error" style="width:100%">
            {{ form.errors | default_errors }}
          </p>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "10% off your first order" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Join the training list" },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Programming notes, restock alerts, and early access to drops."
    }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
