<section class="section">
  <div class="page-width">
    <div class="image-with-text reveal {% if section.settings.layout == 'reverse' %}image-with-text--reverse{% endif %}">
      <div class="image-with-text__media">
        {%- if section.settings.image != blank -%}
          <img
            src="{{ section.settings.image | image_url: width: 1200 }}"
            srcset="{{ section.settings.image | image_url: width: 600 }} 600w, {{ section.settings.image | image_url: width: 1200 }} 1200w"
            sizes="(min-width: 750px) 50vw, 100vw"
            alt="{{ section.settings.image.alt | escape }}"
            width="{{ section.settings.image.width }}"
            height="{{ section.settings.image.height }}"
            loading="lazy"
          >
        {%- else -%}
          {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>

      <div class="image-with-text__content">
        {%- if section.settings.eyebrow != blank -%}
          <span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>
        {%- endif -%}
        <h2>{{ section.settings.heading | escape }}</h2>
        <div class="rte text-muted">{{ section.settings.text }}</div>
        {%- if section.settings.button_label != blank -%}
          <a class="button" href="{{ section.settings.button_link }}">{{ section.settings.button_label | escape }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Image with text",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Why Ironforge" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Built to be handed down" },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Every bar is knurled and tested in-house. Every bell is single-cast, then powder-coated so chalk grips instead of slides. We spec the same equipment we put in the training rooms we work with — which is why the warranty is lifetime and the returns window is 60 days.</p>"
    },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Our standards" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "normal", "label": "Image left" },
        { "value": "reverse", "label": "Image right" }
      ],
      "default": "normal"
    }
  ],
  "presets": [{ "name": "Image with text" }]
}
{% endschema %}
