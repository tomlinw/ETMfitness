<footer class="footer">
  <div class="page-width">
    <div class="footer__top">
      <div class="footer__brand">
        <div class="footer__heading">{{ shop.name }}</div>
        <p>{{ section.settings.about_text | default: settings.brand_tagline }}</p>

        <div class="social">
          {%- if settings.social_instagram_link != blank -%}
            <a href="{{ settings.social_instagram_link }}" aria-label="Instagram">{% render 'icon', icon: 'instagram', size: 18 %}</a>
          {%- endif -%}
          {%- if settings.social_tiktok_link != blank -%}
            <a href="{{ settings.social_tiktok_link }}" aria-label="TikTok">{% render 'icon', icon: 'tiktok', size: 18 %}</a>
          {%- endif -%}
          {%- if settings.social_youtube_link != blank -%}
            <a href="{{ settings.social_youtube_link }}" aria-label="YouTube">{% render 'icon', icon: 'youtube', size: 18 %}</a>
          {%- endif -%}
          {%- if settings.social_facebook_link != blank -%}
            <a href="{{ settings.social_facebook_link }}" aria-label="Facebook">{% render 'icon', icon: 'facebook', size: 18 %}</a>
          {%- endif -%}
          {%- if settings.social_x_link != blank -%}
            <a href="{{ settings.social_x_link }}" aria-label="X">{% render 'icon', icon: 'x', size: 18 %}</a>
          {%- endif -%}
        </div>
      </div>

      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'menu' -%}
            <div {{ block.shopify_attributes }}>
              <div class="footer__heading">{{ block.settings.heading | escape }}</div>
              <ul class="footer__links" role="list">
                {%- for link in block.settings.menu.links -%}
                  <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
                {%- endfor -%}
              </ul>
            </div>

          {%- when 'text' -%}
            <div {{ block.shopify_attributes }}>
              <div class="footer__heading">{{ block.settings.heading | escape }}</div>
              <div class="rte text-muted">{{ block.settings.text }}</div>
            </div>

          {%- when 'newsletter' -%}
            <div {{ block.shopify_attributes }}>
              <div class="footer__heading">{{ block.settings.heading | escape }}</div>
              <p class="text-muted" style="font-size:.9rem">{{ block.settings.text | escape }}</p>
              {%- form 'customer', class: 'newsletter__form', style: 'margin-top:1rem' -%}
                <input type="hidden" name="contact[tags]" value="newsletter">
                <label class="visually-hidden" for="FooterEmail">{{ 'general.newsletter_form.email_placeholder' | t }}</label>
                <input
                  class="input"
                  id="FooterEmail"
                  type="email"
                  name="contact[email]"
                  placeholder="{{ 'general.newsletter_form.email_placeholder' | t }}"
                  required
                >
                <button class="button" type="submit">{{ 'general.newsletter_form.submit' | t }}</button>
                {%- if form.posted_successfully? -%}
                  <p class="form-status form-status--success">{{ 'general.newsletter_form.success' | t }}</p>
                {%- endif -%}
              {%- endform -%}
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>

    <div class="footer__bottom">
      <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ powered_by_link }}</span>

      {%- if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
        <div class="payment-icons">
          <span class="visually-hidden">{{ 'sections.footer.payment_methods' | t }}</span>
          {%- for type in shop.enabled_payment_types -%}
            {{ type | payment_type_svg_tag: class: 'payment-icon' }}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "textarea",
      "id": "about_text",
      "label": "About text",
      "default": "Built for people who show up. Commercial-grade training equipment, tested by coaches, priced without the showroom markup."
    },
    { "type": "checkbox", "id": "show_payment_icons", "label": "Show payment icons", "default": true }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Support" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Mon–Fri, 9–5 PT<br>help@example.com</p>" }
      ]
    },
    {
      "type": "newsletter",
      "name": "Newsletter",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Training intel" },
        { "type": "text", "id": "text", "label": "Text", "default": "Programming tips and first access to drops. No spam." }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "menu" },
      { "type": "text" },
      { "type": "newsletter" }
    ]
  }
}
{% endschema %}
