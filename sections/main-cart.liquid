<div class="page-width">
  <div style="padding-top:2rem">
    <h1>{{ 'cart.general.title' | t }}</h1>
  </div>

  {%- if cart.item_count == 0 -%}
    <div class="empty-state">
      {% render 'icon', icon: 'cart', size: 40 %}
      <h2 class="h3">{{ 'cart.general.empty' | t }}</h2>
      <p class="text-muted">{{ 'cart.general.empty_body' | t }}</p>
      <a class="button" href="{{ routes.all_products_collection_url }}">{{ 'general.continue_shopping' | t }}</a>
    </div>
  {%- else -%}
    <form action="{{ routes.cart_url }}" method="post" novalidate class="cart-page">
      <div>
        {% render 'cart-items', context: 'page' %}

        {%- if settings.cart_show_note -%}
          <div class="field" style="margin-top:1.5rem">
            <label class="field__label" for="CartNote">{{ 'cart.general.note' | t }}</label>
            <textarea
              class="input"
              id="CartNote"
              name="note"
              data-cart-note
              placeholder="{{ 'cart.general.note_placeholder' | t }}"
            >{{ cart.note }}</textarea>
          </div>
        {%- endif -%}
      </div>

      <aside class="cart-summary">
        <h2 class="h3">{{ 'cart.general.total' | t }}</h2>

        {%- for discount in cart.cart_level_discount_applications -%}
          <div class="cart-totals" style="font-size:.9rem">
            <span class="badge">{{ discount.title }}</span>
            <span>−{{ discount.total_allocated_amount | money }}</span>
          </div>
        {%- endfor -%}

        <div class="cart-totals">
          <span>{{ 'cart.general.subtotal' | t }}</span>
          <span>{{ cart.total_price | money_with_currency }}</span>
        </div>

        <p class="text-muted" style="font-size:.85rem; margin:0">
          {{ 'cart.general.taxes_and_shipping_at_checkout' | t }}
        </p>

        <button class="button button--full" type="submit" name="checkout">
          {{ 'cart.general.checkout' | t }}
        </button>

        {%- if additional_checkout_buttons -%}
          <div>{{ content_for_additional_checkout_buttons }}</div>
        {%- endif -%}

        <a class="link-arrow" href="{{ routes.all_products_collection_url }}" style="justify-self:start">
          {{ 'general.continue_shopping' | t }}
          {% render 'icon', icon: 'arrow-right', size: 15 %}
        </a>
      </aside>
    </form>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Cart"
}
{% endschema %}
