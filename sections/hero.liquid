<section
  class="hero {% if section.settings.alignment == 'center' %}hero--center{% endif %} hero--dark"
  style="--hero-height: {{ section.settings.height }}vh; --overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }}"
>
  <div class="hero__media">
    {%- if section.settings.video != blank -%}
      {{
        section.settings.video
        | video_tag: image_size: '1600x', autoplay: true, loop: true, muted: true, controls: false, playsinline: true
      }}
    {%- elsif section.settings.image != blank -%}
      <img
        src="{{ section.settings.image | image_url: width: 2400 }}"
        srcset="{{ section.settings.image | image_url: width: 800 }} 800w, {{ section.settings.image | image_url: width: 1400 }} 1400w, {{ section.settings.image | image_url: width: 2400 }} 2400w"
        sizes="100vw"
        alt="{{ section.settings.image.alt | escape }}"
        width="{{ section.settings.image.width }}"
        height="{{ section.settings.image.height }}"
        fetchpriority="high"
      >
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}
  </div>

  <div class="hero__overlay"></div>

  <div class="page-width">
    <div class="hero__content">
      {%- if section.settings.eyebrow != blank -%}
        <span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h1 class="h0">{{ section.settings.heading | escape }}</h1>
      {%- endif -%}

      {%- if section.settings.subheading != blank -%}
        <p class="hero__subheading">{{ section.settings.subheading | escape }}</p>
      {%- endif -%}

      {%- if section.settings.button_label != blank or section.settings.button_2_label != blank -%}
        <div class="hero__buttons">
          {%- if section.settings.button_label != blank -%}
            <a class="button" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
              {{ section.settings.button_label | escape }}
            </a>
          {%- endif -%}
          {%- if section.settings.button_2_label != blank -%}
            <a class="button button--secondary" href="{{ section.settings.button_2_link }}" style="--btn-fg:#fff; --btn-border:rgba(255,255,255,.4)">
              {{ section.settings.button_2_label | escape }}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "video", "id": "video", "label": "Background video", "info": "Overrides the image when set." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "New — Forged Series" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Train like it matters" },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Commercial-grade barbells, bells and benches built to outlast the programme you're on."
    },
    { "type": "text", "id": "button_label", "label": "Primary button", "default": "Shop all gear" },
    { "type": "url", "id": "button_link", "label": "Primary button link" },
    { "type": "text", "id": "button_2_label", "label": "Secondary button", "default": "Build your home gym" },
    { "type": "url", "id": "button_2_link", "label": "Secondary button link" },
    {
      "type": "select",
      "id": "alignment",
      "label": "Content alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    },
    { "type": "range", "id": "height", "min": 50, "max": 100, "step": 5, "unit": "vh", "label": "Height", "default": 80 },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "label": "Overlay opacity",
      "default": 55
    }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
