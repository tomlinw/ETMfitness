<section class="section">
  <div class="page-width">
    <div class="section-header reveal">
      <div class="section-header__text">
        {%- if section.settings.eyebrow != blank -%}
          <span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>
        {%- endif -%}
        <h2>{{ section.settings.heading | escape }}</h2>
      </div>
    </div>

    <div class="testimonials reveal">
      {%- for block in section.blocks -%}
        <figure class="testimonial" {{ block.shopify_attributes }}>
          {%- if block.settings.rating > 0 -%}
            <span
              class="rating__stars"
              style="--rating: {{ block.settings.rating }}; --rating-max: 5"
              role="img"
              aria-label="{{ 'accessibility.star_rating' | t: rating: block.settings.rating, scale: 5 }}"
            >★★★★★</span>
          {%- endif -%}
          <blockquote class="testimonial__quote">“{{ block.settings.quote | escape }}”</blockquote>
          <figcaption class="testimonial__author">{{ block.settings.author | escape }}</figcaption>
        </figure>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Testimonials",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Reviews" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What the gym floor says" }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "Third year on the same bar. Knurling still bites, spin is still smooth, and it lives on an unheated garage rack."
        },
        { "type": "text", "id": "author", "label": "Author", "default": "Dana R. — Verified buyer" },
        { "type": "range", "id": "rating", "min": 0, "max": 5, "step": 1, "label": "Rating", "default": 5 }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [{ "type": "testimonial" }, { "type": "testimonial" }, { "type": "testimonial" }]
    }
  ]
}
{% endschema %}
